{
  "name": "sakra-sdk-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @sakra-trust/verify build && pnpm --filter @sakra-trust/sdk build",
    "typecheck": "pnpm --recursive exec tsc --noEmit",
    "test": "pnpm --filter @sakra-trust/verify test && pnpm --filter @sakra-trust/sdk test"
  }
}
