{
  "name": "@intyga/sdk",
  "version": "1.1.0",
  "description": "INTYGA SDK — require a cryptographically-signed human approval for any high-risk backend action (AI agents, humans, services), with zero-knowledge policy encryption.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/sdk.git"
  },
  "homepage": "https://www.intyga.com",
  "bugs": "https://github.com/intyga-dev/sdk/issues",
  "keywords": [
    "authorization",
    "human-approval",
    "webauthn",
    "passkey",
    "audit",
    "receipts",
    "mcp",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    }
  },
  "bin": {
    "intyga": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@intyga/verify": "^1.1.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=87 --test-coverage-branches=75 --test-coverage-functions=88 --test-coverage-exclude='../**' --test-coverage-exclude='dist/cli.js' --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
